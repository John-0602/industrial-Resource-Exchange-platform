        {
          "name": "Admin: List Companies for Verification",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{resource_service_url}}/api/auth/admin/companies",
              "host": ["{{resource_service_url}}"],
