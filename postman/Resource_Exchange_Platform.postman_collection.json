    {
      "name": "1. Student Authentication",
      "item": [
        {
          "name": "Register Student (Priya Sharma)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('student_token', json.data.token);",
                  "    pm.environment.set('student_id', json.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya Sharma\",\n  \"email\": \"priya.sharma@apex.edu\",\n  \"password\": \"Password@123\",\n  \"collegeName\": \"Apex Engineering Institute\",\n  \"department\": \"Computer Science and Engineering\"\n}"
            },
            "url": {
              "raw": "{{resource_service_url}}/api/auth/register",
              "host": ["{{resource_service_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Register Student - Reject Duplicate Email (Negative)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate Priya\",\n  \"email\": \"priya.sharma@apex.edu\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{resource_service_url}}/api/auth/register",
              "host": ["{{resource_service_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Login Student (Rahul Verma)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('second_student_token', json.data.token);",
                  "    pm.environment.set('second_student_id', json.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul.verma@apex.edu\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{resource_service_url}}/api/auth/login",
              "host": ["{{resource_service_url}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Login - Invalid Password (Negative)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul.verma@apex.edu\",\n  \"password\": \"WrongSecret\"\n}"
            },
            "url": {
              "raw": "{{resource_service_url}}/api/auth/login",
              "host": ["{{resource_service_url}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Get Authenticated Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
