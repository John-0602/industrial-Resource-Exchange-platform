                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rajesh@kalyaniforge.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{resource_service_url}}/api/auth/login",
              "host": ["{{resource_service_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Admin (IREP Governance)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('admin_token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
