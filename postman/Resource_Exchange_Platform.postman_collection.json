    },
    {
      "name": "2. Resource Service CRUD & Search",
      "item": [
        {
          "name": "Publish Industrial By-Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('resource_id', json.data._id || json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{supplier_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test 100% Comber Noil Cotton Scraps\",\n  \"category\": \"Textile and fabric waste\",\n  \"resourceType\": \"By-product\",\n  \"description\": \"Clean dry unbleached textile fibers from carding process.\",\n  \"totalQuantity\": 2500,\n  \"availableQuantity\": 2500,\n  \"unit\": \"kg\",\n  \"materialCondition\": \"Production Scrap\",\n  \"composition\": \"100% Raw Cotton Cellulose\",\n  \"pricePerUnit\": 28,\n  \"currency\": \"INR\",\n  \"minOrderQuantity\": 100,\n  \"pickupLocation\": {\n    \"address\": \"Plot 42, SIDCO Industrial Estate\",\n    \"city\": \"Coimbatore\",\n    \"state\": \"Tamil Nadu\",\n    \"country\": \"India\",\n    \"loadingEquipmentAvailable\": true\n  },\n  \"compliance\": {\n    \"hazardousMaterial\": false,\n    \"pcbCategory\": \"Green (Non-hazardous residue)\"\n  }\n}"
            },
            "url": {
              "raw": "{{resource_service_url}}/api/resources",
              "host": ["{{resource_service_url}}"],
              "path": ["api", "resources"]
            }
          }
        },
        {
          "name": "Get All Resources (with category filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{resource_service_url}}/api/resources?category=Textile and fabric waste",
              "host": ["{{resource_service_url}}"],
              "path": ["api", "resources"],
              "query": [{ "key": "category", "value": "Textile and fabric waste" }]
            }
          }
        },
        {
          "name": "Get Resource By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{resource_service_url}}/api/resources/{{resource_id}}",
              "host": ["{{resource_service_url}}"],
              "path": ["api", "resources", "{{resource_id}}"]
            }
          }
        },
        {
          "name": "Keyword Search Resources",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{resource_service_url}}/api/resources/search?q=cotton",
              "host": ["{{resource_service_url}}"],
              "path": ["api", "resources", "search"],
              "query": [{ "key": "q", "value": "cotton" }]
            }
          }
        }
      ]
    },
    {
      "name": "3. Material Requirements & Matching Engine",
      "item": [
        {
          "name": "Post Material Requirement (Procurement Need)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('requirement_id', json.data._id || json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{receiver_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"materialCategory\": \"Textile and fabric waste\",\n  \"materialTitle\": \"Raw Cotton Waste for Insulation\",\n  \"specificationDetails\": \"Clean dry unbleached fiber scraps with low dust.\",\n  \"requiredQuantity\": 500,\n  \"unit\": \"kg\",\n  \"acceptableCondition\": \"Production Scrap\",\n  \"deliveryLocation\": {\n    \"city\": \"Coimbatore\",\n    \"state\": \"Tamil Nadu\",\n    \"country\": \"India\"\n  },\n  \"maxBudgetPerUnit\": 35,\n  \"currency\": \"INR\"\n}"
            },
            "url": {
              "raw": "{{exchange_service_url}}/api/requirements",
              "host": ["{{exchange_service_url}}"],
              "path": ["api", "requirements"]
            }
          }
        },
        {
          "name": "Run Circular Matching Engine (REST Call to Resource Service)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{receiver_token}}" }
            ],
            "url": {
              "raw": "{{exchange_service_url}}/api/matches/{{requirement_id}}",
              "host": ["{{exchange_service_url}}"],
              "path": ["api", "matches", "{{requirement_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Exchange Proposals & Stock Reservations",
      "item": [
        {
          "name": "Create Exchange Proposal (Submits B2B Proposal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('exchange_id', json.data._id || json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{receiver_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": \"{{resource_id}}\",\n  \"requestedQuantity\": 500,\n  \"unit\": \"kg\",\n  \"proposedPricePerUnit\": 26,\n  \"currency\": \"INR\",\n  \"proposalMessage\": \"Intend to reprocess cotton fiber into acoustic insulation panels.\",\n  \"deliveryTerms\": \"Ex-Works pickup arranged by buyer logistics\",\n  \"complianceAck\": true\n}"
            },
            "url": {
              "raw": "{{exchange_service_url}}/api/exchanges",
              "host": ["{{exchange_service_url}}"],
              "path": ["api", "exchanges"]
            }
          }
        },
        {
          "name": "Add Negotiation Message / Counter Offer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{supplier_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Can dispatch on Friday. Minimum viable rate is ₹27/kg for this batch.\",\n  \"proposedPrice\": 27\n}"
            },
            "url": {
              "raw": "{{exchange_service_url}}/api/exchanges/{{exchange_id}}/negotiate",
              "host": ["{{exchange_service_url}}"],
              "path": ["api", "exchanges", "{{exchange_id}}", "negotiate"]
            }
          }
        },
        {
          "name": "Accept Proposal (Coordinates Atomic Stock Reservation)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{supplier_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Accepted\"\n}"
            },
            "url": {
              "raw": "{{exchange_service_url}}/api/exchanges/{{exchange_id}}/status",
              "host": ["{{exchange_service_url}}"],
              "path": ["api", "exchanges", "{{exchange_id}}", "status"]
            }
          }
        },
        {
          "name": "Verify Reserved Quantity on Resource Service",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{resource_service_url}}/api/resources/{{resource_id}}",
              "host": ["{{resource_service_url}}"],
              "path": ["api", "resources", "{{resource_id}}"]
            }
          }
        },
        {
          "name": "Dispatch Consignment (Status: In Transfer)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{supplier_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Transfer\",\n  \"transferTracking\": {\n    \"carrierName\": \"VRL Logistics Ltd\",\n    \"trackingRef\": \"TRK-BLR-004921\",\n    \"transferNotes\": \"Dispatched in 10 baled bundles on open truck.\"\n  }\n}"
            },
            "url": {
              "raw": "{{exchange_service_url}}/api/exchanges/{{exchange_id}}/status",
              "host": ["{{exchange_service_url}}"],
              "path": ["api", "exchanges", "{{exchange_id}}", "status"]
            }
          }
        },
        {
          "name": "Mark Complete (Permanently Deducts Reserved Stock)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{supplier_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Completed\"\n}"
            },
            "url": {
              "raw": "{{exchange_service_url}}/api/exchanges/{{exchange_id}}/status",
              "host": ["{{exchange_service_url}}"],
              "path": ["api", "exchanges", "{{exchange_id}}", "status"]
            }
          }
        }
      ]
    }
  ]
}
