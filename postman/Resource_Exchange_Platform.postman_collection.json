{
  "info": {
    "_postman_id": "8f7e2a1b-3c4d-5e6f-7a8b-9c0d1e2f3a4b",
    "name": "Industrial Resource Exchange Platform (IREP) API Collection",
    "description": "Comprehensive API collection for the Industrial Resource Exchange Platform (IREP). Validates enterprise authentication, industrial catalog CRUD, procurement requirements, cross-service circular matching, B2B exchange lifecycle, atomic quantity reservation, and admin governance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health Checks",
      "item": [
        {
          "name": "Resource Service Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{resource_service_url}}/health",
              "host": ["{{resource_service_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Exchange Service Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{exchange_service_url}}/health",
              "host": ["{{exchange_service_url}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Corporate Authentication & Admin Review",
      "item": [
        {
          "name": "Login Supplier (Apex Textiles)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('supplier_token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"karthik@apextextiles.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{resource_service_url}}/api/auth/login",
              "host": ["{{resource_service_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Receiver (Kalyani Forge)",
          "event": [
